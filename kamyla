#include <stdio.h>

int main() {
    int ids[100], opcao, total = 0;
    char nomes[100][50];
    char matriculas[100][20];

    do {
        // Entrada de dados
        printf("\nDigite o ID do aluno: ");
        scanf("%d", &ids[total]);

        printf("Digite o nome do aluno: ");
        scanf(" %[^\n]", nomes[total]);

        printf("Digite a matricula do aluno: ");
        scanf("%s", matriculas[total]);

        total++; // aumenta a quantidade de alunos

        // Pergunta se deseja repetir
        printf("\nDeseja cadastrar outro aluno? (1 = Sim / 0 = Nao): ");
        scanf("%d", &opcao);

    } while (opcao == 1);

    // Tabela final
    printf("\n===== TABELA DE ALUNOS =====\n");
    printf("ID\tNome\t\tMatricula\n");

    for (int i = 0; i < total; i++) {
        printf("%d\t%s\t\t%s\n", ids[i], nomes[i], matriculas[i]);
    }

    printf("\nPrograma encerrado.\n");

    return 0;
}
